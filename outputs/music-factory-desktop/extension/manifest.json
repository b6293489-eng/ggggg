{
  "manifest_version": 3,
  "name": "Music Factory Bridge",
  "version": "2.2.3",
  "minimum_chrome_version": "120",
  "description": "Connect this signed-in SoundCloud profile to your local Music Factory.",
  "permissions": ["storage", "alarms", "tabs"],
  "host_permissions": ["http://127.0.0.1/*", "https://soundcloud.com/*", "https://artists.soundcloud.com/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html", "default_title": "Music Factory"},
  "content_scripts": [{
    "matches": ["https://soundcloud.com/*", "https://artists.soundcloud.com/*"],
    "js": ["core.js", "content.js"],
    "run_at": "document_idle"
  }]
}
